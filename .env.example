# Required. Generate with: openssl rand -hex 32
IDENTITY_SECRET=

# Optional overrides; compose.yml already uses these defaults.
DATA_DIR=/data
PORT=8080
LOG_LEVEL=info

# Optional Discord gateway credential. Required only when Discord endpoints are configured.
# Set DISCORD_BOT_TOKEN directly OR mount a secret file and set DISCORD_BOT_TOKEN_FILE.
# Never set both.
DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN_FILE=

# Host path or volume name for where data folder resides (default: ./data)
MESSAGE_SYNC_DATA_DIR=./data